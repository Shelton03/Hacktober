# SME Business OS — environment template
# Copy to .env and fill in:  cp .env.example .env

# --- Django core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed for CSRF (comma-separated URLs, e.g. the frontend)
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Set to 1 behind TLS (enables SSL redirect, secure cookies, HSTS)
ENFORCE_TLS=0
TIME_ZONE=Africa/Harare

# --- Database ---
# Leave empty for local SQLite. Docker Compose sets this to Postgres.
# DATABASE_URL=postgres://smebos:smebos@db:5432/smebos

# --- Demo data ---
# 1 = run seed_demo automatically on container start
SEED_DEMO=1

# --- Intelligence: Gemma via Google Vertex AI (API-key / express mode) ---
# Paste the Vertex AI / Google AI API key here. Leave empty to run with the
# template fallback (the app stays fully functional without it).
GOOGLE_API_KEY=
# Publisher model id on Vertex AI
GEMMA_MODEL=gemma-3-27b-it
# Optional: pin calls to a specific Cloud project/location instead of the
# API-key express endpoint (leave blank for express mode).
VERTEX_PROJECT=
VERTEX_LOCATION=global
GEMMA_TIMEOUT=30
# Max output tokens per call; 0 = uncapped
GEMMA_MAX_OUTPUT_TOKENS=0
# Feature flags for the advisor's LLM phrasing (template fallback always works)
INTELLIGENCE_ENABLED=1
INTELLIGENCE_LLM_PHRASING=1

# --- ZIMRA FDMS ---
# MOCK (default, offline demo) | TEST (ZIMRA test env) | PRODUCTION (feature-flagged)
FDMS_MODE=MOCK
